# Ortam degiskenleri -- ORNEK DOSYA
#
# Bu dosya DEGERLERI DEGIL, hangi degiskenlerin gerektigini anlatir.
# Gercek degerler `.env` dosyasina yazilir ve o dosya .gitignore'da.
#
# Deploy ortaminda (Vercel / sunucu) ayni adlarla tanimlanmalari gerekir;
# eksik olanlar derlemeyi BOZMAZ ama calisma aninda ilgili ozellik
# sessizce calismaz ya da istek patlar.
#
# Liste koddan uretildi: `grep -rho "process\.env\.[A-Z_]*" server api nuxt.config.ts`

# ---------------------------------------------------------------------
# VERITABANI -- ZORUNLU
# ---------------------------------------------------------------------
# Olmadan uygulama acilir ama HER veri istegi patlar.
# Ayni degerleri iki yer okuyor: server/utils/db.ts ve api/index.js
# (gerekcesi db.ts icinde).
#
# [!] db.ts ve api/index.js `encrypt: false` kullaniyor. Sunucu
#     yerel agda oldugu surece sorun degil; INTERNET UZERINDEN
#     baglanilacaksa (orn. Vercel'den) sifresiz trafik demektir --
#     encrypt: true yapilip sertifika ayarlanmali.
DB_SERVER=
DB_NAME=
DB_USER=
DB_PASSWORD=

# ---------------------------------------------------------------------
# OTURUM -- ZORUNLU
# ---------------------------------------------------------------------
# api/index.js'teki authenticateToken bunu kullaniyor. Yanlis/eksik
# olursa her korumali uc 401 doner, yani kullanici giris yapamaz.
JWT_SECRET=

# ---------------------------------------------------------------------
# E-POSTA -- teklif/proforma gonderimi icin
# ---------------------------------------------------------------------
# Eksikse mail gonderen ekranlar hata verir, geri kalan calisir.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# ---------------------------------------------------------------------
# DOSYA DEPOLAMA (DigitalOcean Spaces, S3 uyumlu)
# ---------------------------------------------------------------------
# Gorsel/dosya yukleyen ekranlar icin. Eksikse yalnizca o ekranlar
# calismaz.
DO_SPACES_ENDPOINT=
DO_SPACES_BUCKET=
DO_SPACES_KEY=
DO_SPACES_SECRET=

# ---------------------------------------------------------------------
# ISTEGE BAGLI
# ---------------------------------------------------------------------
# ETA hatirlatma zamanlayicisi. Varsayilan KAPALI.
# [!] Vercel'de ACILMAMALI: zamanlayici uzun omurlu bir surec gerektirir,
#     serverless'ta ya hic calismaz ya da her istekte yeniden kurulur.
ETA_REMINDER_ENABLED=0

# Istek suresi gunlugu (hata ayiklama). Bos birakilirsa kapali.
PERF_LOG=
PERF_LOG_MS=

# pm2 cluster'da ornek numarasi -- pm2 kendi doldurur, elle verilmez.
# NODE_APP_INSTANCE=
